BlueMoon-inspired lobby shell. Element panels are declared inside the sidebar content host and
moved to the on-screen columns at runtime by LobbyGui.ApplyLayout().
-->

<lobbyUi:LobbyGui
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:vote="clr-namespace:Content.Client.Voting.UI"
    xmlns:lobbyUi="clr-namespace:Content.Client.Lobby.UI"
    xmlns:info="clr-namespace:Content.Client.Info"
    xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Chat.Widgets">

    <!-- Background -->
    <TextureRect Access="Public" VerticalExpand="True" HorizontalExpand="True" Name="Background"
                 Stretch="KeepAspectCovered" />

    <!-- BlueMoon-style darkening overlay so the menu stays readable over any background -->
    <PanelContainer Name="DimOverlay" HorizontalExpand="True" VerticalExpand="True" MouseFilter="Ignore" />

    <BoxContainer Name="MainContainer" VerticalExpand="True" HorizontalExpand="True" Orientation="Horizontal"
                  Margin="10 10 10 10" SeparationOverride="6">
        <!-- On-screen area -->
        <BoxContainer Name="LeftSide" Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True"
                      VerticalExpand="True">
            <LayoutContainer Name="DefaultState" VerticalExpand="True" HorizontalExpand="True">
                <!-- Free-floating, draggable on-screen panels. Positions are set in code. -->
                <LayoutContainer Name="FloatingPanelLayer" MouseFilter="Pass" />

                <!-- Vote popups live above the on-screen content. -->
                <BoxContainer Name="VoteContainer" Access="Public" Orientation="Vertical" SeparationOverride="4" />

                <!-- Patron / server lobby messages, moved here by SetLobbyMessage(). -->
                <PanelContainer Name="LobbyMessagePanel" Visible="False" MaxWidth="720">
                    <RichTextLabel Name="LobbyMessageLabel" Access="Public" Margin="8" />
                </PanelContainer>
            </LayoutContainer>

            <!-- Character setup state -->
            <Control Access="Public" Visible="False" Name="CharacterSetupState" VerticalExpand="True"
                     HorizontalExpand="True" />
        </BoxContainer>

        <!-- BlueMoon-style right sidebar -->
        <PanelContainer Name="RightSide" Access="Public" VerticalExpand="True" SetWidth="340">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="4">
                <BoxContainer Name="HeaderContainer" Orientation="Horizontal" MinSize="0 44" SeparationOverride="4"
                              Margin="10 8 4 0">
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center">
                        <Label Name="LobbyLogo" Text="ERIDA GOOB" StyleClasses="LabelHeadingBigger"
                               FontColorOverride="#8FC7FF" />
                        <Label Name="ServerName" Access="Public" StyleClasses="LabelSubText" ClipText="True"
                               FontColorOverride="#5F7FAF" HorizontalAlignment="Left" />
                    </BoxContainer>
                    <Button Name="LobbyLayoutQuickToggleButton" Text="⇄" MinWidth="30"
                            ToolTip="{Loc 'lobby-layout-quick-toggle'}" />
                    <TextureButton Name="CollapseButton"
                                   TexturePath="filled_right_arrow.svg.192dpi"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   ModulateSelfOverride="#9ABDE8"
                                   ToolTip="{Loc 'lobby-layout-collapse'}"
                                   Scale="0.5 0.5" />
                    <Button Name="LobbySettingsButton" Text="⚙" MinWidth="30"
                            ToolTip="{Loc 'lobby-layout-settings-button'}" />
                </BoxContainer>

                <PanelContainer Name="HeaderDivider" MinHeight="1" Margin="8 0 8 0" />

                <ScrollContainer Name="SidebarScroll" VerticalExpand="True" HScrollEnabled="False" Margin="6 0 6 0">
                    <BoxContainer Name="SidebarScrollBox" Orientation="Vertical" SeparationOverride="6"
                                  HorizontalExpand="True">
                        <!-- Layout settings -->
                        <PanelContainer Name="LobbySettingsPanel" Visible="False">
                            <BoxContainer Orientation="Vertical" SeparationOverride="5">
                                <Label Name="LobbyLayoutTitle" StyleClasses="LabelSubText"
                                       FontColorOverride="#8FC7FF" />
                                <Label Name="LobbyLayoutPresetLabel" StyleClasses="LabelSubText"
                                       FontColorOverride="#5F7FAF" />
                                <Label Name="LobbyLayoutOverflowLabel" StyleClasses="LabelSubText" ClipText="True"
                                       FontColorOverride="#FFB86B" Visible="False" />
                                <Button Name="LayoutPresetSidebarButton"
                                        Text="{Loc 'lobby-layout-preset-sidebar'}" />
                                <Button Name="LayoutPresetOnScreenButton"
                                        Text="{Loc 'lobby-layout-preset-screen'}" />
                                <Button Name="LayoutPresetCustomButton"
                                        Text="{Loc 'lobby-layout-preset-custom'}"
                                        ToolTip="{Loc 'lobby-layout-preset-custom-tooltip'}" />
                                <PanelContainer Name="LayoutSettingsDivider" MinHeight="1" Margin="0 2 0 2" />
                                <BoxContainer Name="LobbyLayoutRows" Orientation="Vertical" SeparationOverride="2" />
                            </BoxContainer>
                        </PanelContainer>

                        <!-- All configurable content. ApplyLayout() moves these panels around. -->
                        <BoxContainer Name="SidebarContentHost" Orientation="Vertical" SeparationOverride="6"
                                      HorizontalExpand="True">
                            <!-- Quick actions / round controls -->
                            <PanelContainer Name="QuickActionsPanel">
                                <BoxContainer Orientation="Vertical" SeparationOverride="2">
                                    <BoxContainer Orientation="Vertical" SeparationOverride="1" Margin="2 2 2 0">
                                        <Label Name="StartTime" Access="Public" HorizontalExpand="True" ClipText="True"
                                               FontColorOverride="#8FC7FF" />
                                        <Label Name="StationTime" Access="Public" ClipText="True"
                                               FontColorOverride="#5F7FAF" StyleClasses="LabelSubText" />
                                    </BoxContainer>
                                    <Button Name="ReadyButton" Access="Public" ToggleMode="True"
                                            Text="{Loc 'ui-lobby-ready-up-button'}" />
                                    <cc:UICommandButton Name="ObserveButton" Access="Public" Command="observe"
                                                        Text="{Loc 'ui-lobby-observe-button'}"
                                                        WindowType="{x:Type lobbyUi:ObserveWarningWindow}" />
                                    <Button Name="ManifestButton" Access="Public"
                                            Text="{Loc 'ui-lobby-manifest-button'}"
                                            ToolTip="{Loc 'lobby-manifest-tooltip'}" />
                                    <PanelContainer Name="QuickActionsDivider1" MinHeight="1" Margin="2 2 2 2" />
                                    <Button Name="CharacterSetupButton" Access="Public"
                                            Text="{Loc 'lobby-character-setup-button'}" />
                                    <Button Name="OptionsButton"
                                            Text="{Loc 'ui-lobby-options-button'}" />
                                    <Button Name="AHelpButton" Access="Public"
                                            Text="{Loc 'ui-lobby-ahelp-button'}" />
                                    <vote:VoteCallMenuButton Name="CallVoteButton" />
                                    <PanelContainer Name="QuickActionsDivider2" MinHeight="1" Margin="2 2 2 2" />
                                    <Button Name="LeaveButton"
                                            Text="{Loc 'ui-lobby-leave-button'}" />
                                </BoxContainer>
                            </PanelContainer>

                            <!-- Links and rules -->
                            <PanelContainer Name="LinksPanel">
                                <BoxContainer Orientation="Vertical" SeparationOverride="4">
                                    <info:LinkBanner Name="LinkBanner" VerticalExpand="False" />
                                </BoxContainer>
                            </PanelContainer>

                            <!-- Server currency -->
                            <PanelContainer Name="BalancePanel">
                                <BoxContainer Orientation="Vertical" SeparationOverride="2">
                                    <Label Name="Balance" Access="Public" StyleClasses="LabelHeadingBigger"
                                           HorizontalAlignment="Left" />
                                </BoxContainer>
                            </PanelContainer>

                            <!-- Server info -->
                            <PanelContainer Name="ServerInfoPanel">
                                <BoxContainer Orientation="Vertical" SeparationOverride="4">
                                    <info:ServerInfo Name="ServerInfo" Access="Public" MinSize="0 30"
                                                     VerticalExpand="False" />
                                </BoxContainer>
                            </PanelContainer>

                            <!-- Character preview -->
                            <PanelContainer Name="CharacterPreviewPanel">
                                <lobbyUi:LobbyCharacterPreviewPanel Name="CharacterPreview" Access="Public" />
                            </PanelContainer>

                            <!-- Chat -->
                            <PanelContainer Name="ChatPanel">
                                <BoxContainer Orientation="Vertical" SeparationOverride="4">
                                    <widgets:ChatBox Name="Chat" Access="Public" VerticalExpand="True" Margin="3"
                                                     MinHeight="50" />
                                </BoxContainer>
                            </PanelContainer>

                            <!-- Playtime comment is only visible when the server sends one. -->
                            <PanelContainer Name="PlaytimePanel">
                                <RichTextLabel Name="PlaytimeComment" Access="Public" Visible="False" />
                            </PanelContainer>

                            <!-- Music player is always the last sidebar section -->
                            <PanelContainer Name="MusicPanel">
                                <BoxContainer Orientation="Vertical" SeparationOverride="4">
                                    <RichTextLabel Name="LobbySong" Access="Public" MinHeight="20" />
                                    <BoxContainer Orientation="Horizontal" SeparationOverride="3">
                                        <Button Name="LobbyMusicPrevButton" Access="Public" Text="◀◀" MinWidth="30"
                                                ToolTip="{Loc 'lobby-music-prev'}" />
                                        <Button Name="LobbyMusicPlayButton" Access="Public" Text="▶" MinWidth="30"
                                                ToolTip="{Loc 'lobby-music-play'}" />
                                        <Button Name="LobbyMusicNextButton" Access="Public" Text="▶▶" MinWidth="30"
                                                ToolTip="{Loc 'lobby-music-next'}" />
                                        <Button Name="LobbyMusicMuteButton" Access="Public" Text="♪" MinWidth="30"
                                                ToolTip="{Loc 'lobby-music-mute'}" />
                                        <Slider Name="LobbyMusicVolume" Access="Public" HorizontalExpand="True"
                                                MinValue="0" MaxValue="100" Value="50" MinHeight="20"
                                                ToolTip="{Loc 'lobby-music-volume'}" />
                                    </BoxContainer>
                                    <CheckBox Name="LobbyMusicEnabledCheck" Access="Public"
                                              Text="{Loc 'lobby-music-enabled'}" />
                                </BoxContainer>
                            </PanelContainer>
                        </BoxContainer>
                    </BoxContainer>
                </ScrollContainer>

                <PanelContainer Name="SidebarFooter">
                    <BoxContainer Orientation="Vertical" SeparationOverride="2">
                        <Label Name="CharacterNameLabel" HorizontalAlignment="Left" ClipText="True"
                               FontColorOverride="#8FC7FF" />
                        <Label Name="OnlineCountLabel" HorizontalAlignment="Left" ClipText="True"
                               StyleClasses="LabelSubText" FontColorOverride="#5F7FAF" />
                        <RichTextLabel Name="LobbyBackground" Access="Public" HorizontalAlignment="Left"
                                       StyleClasses="LabelSubText" Margin="2 2 2 0" />
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
        </PanelContainer>

        <!-- Shown while the sidebar is collapsed -->
        <PanelContainer Name="ExpandPanel" Visible="False" VerticalAlignment="Top" HorizontalAlignment="Right"
                        MinWidth="30" MinHeight="76" Margin="0 2 2 0">
            <BoxContainer Orientation="Vertical" SeparationOverride="2" HorizontalAlignment="Center">
                <TextureButton Name="ExpandButton"
                               TexturePath="filled_left_arrow.svg.192dpi"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               ModulateSelfOverride="#9ABDE8"
                               ToolTip="{Loc 'lobby-layout-expand'}"
                               Scale="0.5 0.5" />
                <Button Name="FloatingSettingsButton" Text="⚙" MinWidth="26"
                        ToolTip="{Loc 'lobby-layout-settings-button'}" />
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</lobbyUi:LobbyGui>
